{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "dist",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["app.ts", "server.ts", "db.ts", "seed.ts", "api/**/*.ts", "controllers/**/*.ts", "middleware/**/*.ts", "routes/**/*.ts", "utils/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
