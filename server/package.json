{
    "name": "eventhub-server",
    "version": "1.0.0",
    "description": "EventHub Backend",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test tests/bookingRules.test.ts tests/featureRules.test.ts",
        "start": "node dist/server.js",
        "dev": "tsx watch server.ts",
        "seed": "tsx seed.ts"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.2",
        "nodemailer": "^6.9.11",
        "pg": "^8.13.1"
    },
    "Dependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^22.10.2",
        "@types/nodemailer": "^6.4.17",
        "@types/pg": "^8.11.10",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
